# StarSol API — copy to .env on the server at /opt/starsol-api/.env

PORT=3402

# MySQL (same RDS as FlightPort/StockTV — new database: starsol_app)
DB_HOST=ls-2eaad50ae859385e99d9252b1cc6a6f20653d808.cbikmcgciqx5.us-west-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=app_starsol_usr
DB_PASSWORD=
DB_NAME=starsol_app
DB_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem

# Auth
JWT_SECRET=generate-64-char-random-string
ADMIN_SECRET=generate-32-char-random-string

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_EXPLORER_MONTHLY=price_...
STRIPE_PRICE_EXPLORER_ANNUAL=price_...
STRIPE_PRICE_OBSERVER_MONTHLY=price_...
STRIPE_PRICE_OBSERVER_ANNUAL=price_...

# Resend (email)
RESEND_API_KEY=re_...
EMAIL_NOREPLY=starsol-noreply@salzventure.com
EMAIL_SUPPORT=starsol@salzventure.com
ADMIN_EMAIL=sjsalzberg@gmail.com

# NASA APOD (Astronomy Picture of the Day) — get a free key at api.nasa.gov
# DEMO_KEY works at 30 req/hr; register a real key for production
NASA_API_KEY=DEMO_KEY

# App
APP_URL=https://starsol.app
CORS_ORIGINS=https://starsol.app,https://www.starsol.app
